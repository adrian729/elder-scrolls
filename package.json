{
  "name": "@ranx729/elder-scrolls",
  "version": "0.1.5",
  "description": "Realistic responsive parchment and scroll surfaces for HTML, JavaScript and React",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian729/elder-scrolls.git"
  },
  "homepage": "https://adrian729.github.io/elder-scrolls/",
  "bugs": {
    "url": "https://github.com/adrian729/elder-scrolls/issues"
  },
  "keywords": [
    "parchment",
    "scroll",
    "medieval",
    "texture",
    "react",
    "vanilla"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./react": {
      "types": "./lib/react.d.ts",
      "import": "./lib/react.js"
    },
    "./styles.css": {
      "types": "./lib/styles.d.ts",
      "default": "./lib/styles.css"
    },
    "./typography.css": {
      "types": "./lib/styles.d.ts",
      "default": "./lib/typography.css"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "lib",
    "assets",
    "docs/INTEGRATION.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "demo:refresh": "node scripts/resolve-demo-illustrations.mjs",
    "build": "python3 scripts/build-library.py && python3 build.py --linked --output dist/index.html",
    "build:browser": "python3 scripts/build-browser.py",
    "prepack": "python3 scripts/build-library.py",
    "test": "node --test tests/*.test.mjs",
    "test:demo": "python3 -m unittest discover -s tests -p 'test_demo_*.py'",
    "test:integration": "node tests/integration.mjs",
    "test:types": "tsc --noEmit --strict --noUncheckedSideEffectImports --module nodenext --target es2022 --jsx react-jsx tests/types.tsx"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@ranx729/medieval-ornaments": "0.7.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
